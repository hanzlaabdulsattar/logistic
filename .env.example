ENVIRONMENT=development
# Local system PostgreSQL (port 5432) — preferred over docker 5433
DATABASE_URL=postgresql+psycopg://logistics:logistics@localhost:5432/logistics
REDIS_URL=redis://localhost:6379/0
# CORS
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ALLOW_ALL=true

# SafePay / payments
# Leave the demo public key / empty secret to use the local demo checkout.
# For real sandbox payments: SafePay dashboard (sandbox) → Developer → API keys / webhooks.
SAFEPAY_ENV=sandbox
SAFEPAY_PUBLIC_KEY=sp_public_demo_key_replace_me
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_MERCHANT_CODE=DEMO_MERCHANT
# Public URL of this API (SafePay redirects the browser to /payments/safepay/return)
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://127.0.0.1:5173
